# Copy this file to .env.local and fill in real values.

# Shopify Storefront API (server-only — no NEXT_PUBLIC_ prefix, so these
# are never sent to the browser). See README.md > Architecture for how
# this is used.
SHOPIFY_STORE_DOMAIN=
SHOPIFY_STOREFRONT_ACCESS_TOKEN=

# Canonical site URL, used for metadata/Open Graph/sitemap/robots
# (lib/seo/site.ts). No NEXT_PUBLIC_ prefix — this is only ever read
# server-side. Falls back to https://novaxastore.store if unset.
SITE_URL=

# Google Analytics 4 measurement ID (optional). Leave blank and
# analytics stays fully disabled — no script is loaded, no tracking
# cookie is set, nothing is sent anywhere. NEXT_PUBLIC_ is intentional
# here: a GA measurement ID isn't a secret, and the client-side script
# loader (components/analytics/Analytics.tsx) genuinely needs it in the
# browser. Never commit a real measurement ID to this example file.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
